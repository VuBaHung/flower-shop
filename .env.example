# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value below may stay EMPTY: with DATA_SOURCE=fixtures the storefront
# builds entirely from data/fixtures.json and needs no account anywhere.
# See PLAN.md §3A.7.
# ---------------------------------------------------------------------------

# --- Storefront (read at BUILD time only) ----------------------------------
# 'fixtures' | 'mongo'. Keep 'fixtures' until MongoDB Atlas exists.
DATA_SOURCE=fixtures
# NEVER prefix these NEXT_PUBLIC_ — that would ship the credential to browsers.
MONGODB_URI=
MONGODB_DB=

# --- Admin app (single static account, PLAN.md §3A.5) ----------------------
ADMIN_USERNAME=
# A bcrypt/argon2 HASH, not the password itself.
ADMIN_PASSWORD_HASH=
# Long random string used to sign the session cookie.
SESSION_SECRET=

# --- Cloudinary (unsigned upload preset, PLAN.md §3A.3) --------------------
# Public by design: an unsigned preset is safe in the browser. Restrict it to
# WebP, max dimensions, and one folder in the Cloudinary dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Publish button -> GitHub repository_dispatch --------------------------
# Fine-grained PAT; only needs the "contents: write" scope on this one repo.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
