# Admin app config. Copy to admin/.env and fill in.
# admin/.env is git-ignored and must never be committed. PLAN.md §3A.7.

# --- MongoDB (same cluster the storefront build reads) ---------------------
MONGODB_URI=
MONGODB_DB=

# --- Single admin account (PLAN.md §3A.5) ----------------------------------
# Generate the hash and secret with:  npm run hash-password -- 'your-password'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Cloudinary unsigned upload preset -------------------------------------
# Public by design. Restrict the preset to WebP + max dimensions + one folder
# in the Cloudinary dashboard — that is where the <=150KB rule is enforced.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Publish button -> GitHub repository_dispatch --------------------------
# Fine-grained PAT with "contents: write" on the storefront repo only.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
